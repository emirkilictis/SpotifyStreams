# ─── Spotify (zorunlu) ───────────────────────────────────────────────────────
# Chrome'da open.spotify.com'a giriş yap,
# DevTools > Application > Cookies > open.spotify.com altından al.

SP_DC=<buraya_sp_dc_cookie_değeri>
SP_KEY=<buraya_sp_key_cookie_değeri>

# ─── PostgreSQL (zorunlu) ────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Örnek (local): postgresql://postgres:mysecret@localhost:5432/spotifystreams
# Örnek (Supabase/Neon): postgresql://postgres:[password]@[host]:5432/postgres

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
