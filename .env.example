# Spotify cookies (required for collection).
# Sign in to open.spotify.com, then open:
# Developer Tools > Application > Cookies > open.spotify.com.
SP_DC=<your_sp_dc_cookie>
SP_KEY=<your_sp_key_cookie>

# PostgreSQL connection URL (required).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local example: postgresql://USER:PASSWORD@localhost:5432/spotifystreams
# Hosted example: postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Required dashboard credentials: use different random values for each.
# Run separately for each value: openssl rand -hex 32
# The server rejects missing, short, or reused required credentials.
# Never commit real credentials.
ADMIN_PASSCODE=
SECADMIN_PASSCODE=
IP_HASH_SECRET=

# Optional access codes for locked artist profiles.
# Use comma-separated independent secrets of at least 32 characters each.
# If omitted, locked profiles remain inaccessible.
JC_PASSCODES=

# Hosted PostgreSQL requires TLS with certificate and hostname verification.
DB_SSL_MODE=verify-full
# Supabase shared poolers use the bundled official public CA automatically.
# To override that CA or configure a different provider, set exactly one:
# DB_SSL_CA_FILE=/absolute/path/provider-ca.crt
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DB_SSL_MODE=disable is allowed only for local loopback development.

# Defaults to 1 on Render and 0 for direct local access.
# Set the trusted proxy count explicitly for a different topology.
# TRUST_PROXY_HOPS=1
